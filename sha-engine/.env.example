# Copy this file to .env and fill it in. .env is gitignored — it never leaves
# your machine, and you never have to paste a key into a chat.
#
#   cp .env.example .env
#   node scripts/check-creds.mjs

# app.composio.dev → Settings → PROJECT SETTINGS → API Keys
#
# It must start with ak_. A key starting ck_ comes from the account-level
# API Keys page and returns 401 on every endpoint — this has cost hours twice.
COMPOSIO_API_KEY=ak_replace_me

# app.composio.dev → Connected Accounts → the Instagram entry.
# Leave blank and run check-creds.mjs — it will find it and print it for you.
COMPOSIO_CONNECTED_ACCOUNT_ID=

COMPOSIO_USER_ID=sha

# Optional. Without it, research falls back to web search, which is fine.
FIRECRAWL_API_KEY=

# Only needed to publish through the API, which this system deliberately does
# not do — Sha posts everything herself. Leave blank.
PUBLIC_MEDIA_BASE_URL=

# /send — the weekly handover email to Sha.
# Connect Gmail in the SAME Composio project, under user id "sha", then run
# check-creds.mjs and it prints the account id for you.
COMPOSIO_GMAIL_ACCOUNT_ID=

# Where the weekly email goes.
SHA_EMAIL=
